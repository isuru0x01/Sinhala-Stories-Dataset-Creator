    classDef clientStyle fill:#EFF6FF,stroke:#1D4ED8,stroke-width:1.5px,color:#0F172A;
    classDef queueStyle fill:#FFFBEB,stroke:#D97706,stroke-width:1.5px,color:#0F172A;
    classDef mergeStyle fill:#ECFDF5,stroke:#059669,stroke-width:1.5px,color:#0F172A;
    classDef fileStyle fill:#FFFFFF,stroke:#64748B,stroke-width:1px,color:#1E293B;
    classDef alertStyle fill:#FEF2F2,stroke:#DC2626,stroke-width:1.2px,color:#991B1B;
    classDef commitStyle fill:#FEF3C7,stroke:#B45309,stroke-width:1.5px,color:#78350F;

    class C1,C2,C3,C3_Exact,C3_Near,C4 clientStyle;
    class C5 alertStyle;
    class Q_Info queueStyle;
    class Q1,Q2,Q3,Q_Dots fileStyle;
    class M1,M2,M3 mergeStyle;
    class M4 commitStyle;
